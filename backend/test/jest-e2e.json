{
    "moduleFileExtensions": ["js", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.e2e-spec\\.ts$",
    "extensionsToTreatAsEsm": [".ts"],
    "transform": {
        "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": { "module": "ESNext" } }]
    },
    "testEnvironment": "node",
    "testTimeout": 30000
}
